{
  "name": "karacca.com",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:worker": "wrangler dev --port 8788",
    "deploy": "astro build && wrangler deploy",
    "lighthouse": "pnpm dlx @lhci/cli@0.15.x autorun",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contributions:update": "node --env-file-if-exists=.env scripts/update-contributions.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "satori": "^0.33.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.145.0",
    "yaml": "^2.9.1"
  }
}
