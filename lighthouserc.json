{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview --port 4322 --ignore-lock",
      "startServerReadyPattern": "localhost:4322",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4322/",
        "http://localhost:4322/about",
        "http://localhost:4322/writing",
        "http://localhost:4322/writing/jetpack-compose-ile-declarative-ui-gelistirme",
        "http://localhost:4322/projects",
        "http://localhost:4322/projects/moodstone"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 1 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    }
  }
}
