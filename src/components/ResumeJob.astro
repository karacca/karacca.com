---
import { isExternal } from "@/lib/paths";
import { site } from "@/site.config";

interface Props {
  role: string;
  company: string;
  href?: string;
  dates: string;
  place: string;
}

const { role, company, href, dates, place } = Astro.props;
const external = href !== undefined && isExternal(href);
---

<div class="job">
  <div class="head">
    <h3 class="role">
      {role}
      {site.labels.metaSeparator}
      {href ? (
        <a
          href={href}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener" : undefined}
        >
          {company}
        </a>
      ) : (
        company
      )}
    </h3>
    <p class="when meta">{[dates, place].join(site.labels.metaSeparator)}</p>
  </div>
  <slot />
</div>

<style>
  .job + .job {
    margin-block-start: var(--space-xl);
  }

  .role {
    margin: 0;
    font-size: var(--text-size-subheading);
  }

  .when {
    margin: 0;
  }

  .head + :global(*) {
    margin-block-start: var(--space-xs);
  }
</style>
