---
import { site } from "@/site.config";
---

<ul class="actions" role="list">
  <li>
    <a
      class="action-link"
      href={site.bookCall.href}
      target="_blank"
      rel="noopener"
    >
      {site.bookCall.label}
    </a>
  </li>
</ul>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-l);
    margin-block-start: var(--space-m);
    font-size: var(--text-size-small);
  }
</style>
