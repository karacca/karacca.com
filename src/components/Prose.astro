---
import ProjectPeeks from "@/components/ProjectPeeks.astro";
import "@/styles/prose.css";

const html = await Astro.slots.render("default");
const projects = [
  ...new Set(
    [...html.matchAll(/href="\/projects\/([^"/?#]+)\/?"/g)].flatMap(([, id]) =>
      id ? [id] : [],
    ),
  ),
];
---

<div class="prose">
  <Fragment set:html={html} />
</div>
{projects.length > 0 && <ProjectPeeks ids={projects} />}
