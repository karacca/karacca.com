---
import type { ImageMetadata } from "astro";
import ThemedImage from "@/components/ThemedImage.astro";
import { image } from "@/styles/tokens/image";

interface Props {
  src: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  caption?: string;
  eager?: boolean;
}

const { src, dark, alt, caption, eager = false } = Astro.props;
---

<figure>
  <ThemedImage
    class="image"
    src={src}
    dark={dark}
    alt={alt}
    widths={[...image.cover.widths]}
    sizes={image.cover.sizes}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-m);
  }
</style>
