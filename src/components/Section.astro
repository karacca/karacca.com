---
interface Props {
  label?: string;
  title?: string;
  hideTitle?: boolean;
  as?: "section" | "header" | "article" | "div";
  lang?: string;
}

const {
  label,
  title,
  hideTitle = false,
  as: Tag = "section",
  lang,
} = Astro.props;
---

<Tag class="section rail-grid">
  <div class="rail">
    {label && <h2 class="meta label">{label}</h2>}
    <slot name="rail" />
  </div>
  <div class="body" lang={lang}>
    {Astro.slots.has("lead") ? (
      <div class="lead">
        <slot name="lead" />
        <div class="heading">
          {title && <h1 class="title">{title}</h1>}
          <slot name="intro" />
        </div>
      </div>
    ) : (
      <>
        {title && (
          <h1 class:list={["title", { "visually-hidden": hideTitle }]}>
            {title}
          </h1>
        )}
        <slot name="intro" />
      </>
    )}
    <slot />
  </div>
</Tag>

<style>
  .rail {
    line-height: calc(var(--text-size-body) * var(--text-leading-body));
  }

  .label {
    font-weight: var(--text-weight-body);
    line-height: inherit;
  }

  .rail :global(.meta) {
    line-height: inherit;
  }

  .body {
    min-width: 0;
  }

  .body:has(:global(.projects)) {
    container-type: inline-size;
  }

  @media (width < 52rem) {
    .rail:not(:has(:global(*))) {
      display: none;
    }
  }

  @media (min-width: 52rem) {
    .section {
      align-items: baseline;
    }
  }

  .title {
    max-width: var(--layout-measure);
    font-size: var(--text-size-title);
    line-height: calc(var(--text-size-body) * var(--text-leading-body));
  }

  .title:not(.visually-hidden) + :global(*) {
    margin-block-start: var(--space-m);
  }

  .lead {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-m);
  }

  .heading {
    align-self: baseline;
  }

  .heading > .title + :global(*) {
    margin-block-start: var(--space-xs);
  }
</style>
