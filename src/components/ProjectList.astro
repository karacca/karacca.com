---
import PlatformLinks from "@/components/PlatformLinks.astro";
import ThemedImage from "@/components/ThemedImage.astro";
import { timeRanks, type Project } from "@/lib/content";
import { site } from "@/site.config";
import { image } from "@/styles/tokens/image";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const ranks = timeRanks(projects);
const hasIcons = projects.some((project) => project.data.icon);
---

<ul class:list={["rows", "projects", { "has-icons": hasIcons }]} role="list">
  {projects.map((project) => {
    const { title, description, year, company, icon } = project.data;
    return (
      <li class="row" style={`--rank-time: ${ranks.get(project.id)}`}>
        {hasIcons &&
          (icon ? (
            <ThemedImage
              class="thumb"
              src={icon.src}
              dark={icon.dark}
              alt=""
              widths={[...image.thumb.widths]}
              sizes={image.thumb.sizes}
            />
          ) : (
            <span class="thumb" aria-hidden="true" />
          ))}
        <div class="main">
          <p class="title">
            <a class="row-link" href={`/projects/${project.id}`}>
              {title}
            </a>
          </p>
          <p class="description muted">{description}</p>
        </div>
        <span class="when meta">
          {[year, company].filter(Boolean).join(site.labels.metaSeparator)}
        </span>
        <PlatformLinks project={project} />
      </li>
    );
  })}
</ul>

<style>
  .projects {
    display: flex;
    flex-direction: column;
  }

  .row {
    flex-wrap: wrap;
  }

  .main {
    flex: 1 1 100%;
    min-width: 0;
  }

  .thumb {
    display: block;
    grid-area: thumb;
    align-self: start;
    width: var(--layout-thumb);
    height: auto;
    aspect-ratio: var(--layout-icon-ratio);
    object-fit: cover;
    border-radius: var(--radius-icon);
    background: var(--color-surface);
  }

  .has-icons .row {
    display: grid;
    grid-template-columns: var(--layout-thumb) minmax(0, 1fr) auto;
    grid-template-areas:
      "thumb main main"
      "thumb when platforms";
    column-gap: var(--space-m);
  }

  .has-icons .main {
    grid-area: main;
  }

  .has-icons .when {
    grid-area: when;
  }

  .has-icons .row > :global(:last-child) {
    grid-area: platforms;
    justify-self: end;
  }

  .title {
    padding-block: calc(
      (var(--text-leading-body) - var(--text-leading-compact)) * 1em / 2
    );
    line-height: var(--text-leading-compact);
  }

  .row-link {
    text-decoration-color: var(--color-link-underline);
  }

  .description {
    max-width: var(--layout-measure);
    font-size: var(--text-size-small);
    line-height: var(--text-leading-compact);
  }

  .when {
    flex: 1 1 auto;
    transition-property: color;
    transition-duration: var(--motion-hover-duration);
    transition-timing-function: var(--motion-hover-ease);
  }

  .row:focus-within {
    --platform-color: var(--color-text-muted);
  }

  @media (hover: hover) {
    .row:hover {
      --platform-color: var(--color-text-muted);
    }

    .row-link:hover {
      text-decoration-color: currentColor;
    }

    .row:has(.row-link):hover .when {
      color: var(--color-text);
    }
  }

  @container (min-width: 40rem) {
    .row {
      flex-wrap: nowrap;
    }

    .main {
      flex: 1 1 0;
    }

    .when {
      flex: none;
      white-space: nowrap;
    }

    .has-icons .row {
      grid-template-columns: var(--layout-thumb) minmax(0, 1fr) auto auto;
      grid-template-areas: "thumb main when platforms";
      column-gap: var(--space-l);
    }

    @supports (grid-template-columns: subgrid) {
      .projects {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        column-gap: var(--space-l);
      }

      .row {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
      }

      .row > :global(:last-child) {
        justify-self: end;
      }

      .projects.has-icons {
        grid-template-columns: var(--layout-thumb) minmax(0, 1fr) auto auto;
      }

      .has-icons .row {
        grid-template-columns: subgrid;
      }
    }
  }
</style>
