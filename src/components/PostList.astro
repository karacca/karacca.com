---
import type { Post } from "@/lib/content";
import { formatDate, isoDate } from "@/lib/format";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="rows" role="list">
  {posts.map((post) => (
    <li class="row">
      <a class="row-link" href={`/writing/${post.id}`}>
        {post.data.title}
      </a>
      <time class="meta" datetime={isoDate(post.data.date)}>
        {formatDate(post.data.date)}
      </time>
    </li>
  ))}
</ul>

<style>
  .row-link {
    min-width: 0;
  }

  time {
    flex: none;
    transition-property: color;
    transition-duration: var(--motion-hover-duration);
    transition-timing-function: var(--motion-hover-ease);
  }

  @media (hover: hover) {
    .row:hover time {
      color: var(--color-text);
    }
  }
</style>
