---
import { render } from "astro:content";
import Chip from "@/components/Chip.astro";
import ResumeHeader from "@/components/ResumeHeader.astro";
import ResumeJob from "@/components/ResumeJob.astro";
import ResumeSection from "@/components/ResumeSection.astro";
import Terms from "@/components/Terms.astro";
import Base from "@/layouts/Base.astro";
import { getPage } from "@/lib/content";

const page = await getPage("resume");
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
  <Content
    components={{
      Chip,
      Header: ResumeHeader,
      Section: ResumeSection,
      Job: ResumeJob,
      Terms,
    }}
  />
</Base>
