---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import Chip from "@/components/Chip.astro";
import Icon from "@/components/Icon.astro";
import PlatformLinks from "@/components/PlatformLinks.astro";
import Prose from "@/components/Prose.astro";
import Section from "@/components/Section.astro";
import Base from "@/layouts/Base.astro";
import { getProjects } from "@/lib/content";
import { formatYears } from "@/lib/format";
import { site } from "@/site.config";

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects
    .filter((project) => project.data.detail)
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props;
const { title, description, start, end, company, cover } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={description} type="article">
  <Section as="article" title={title}>
    <div class="project-meta" slot="rail">
      <a class="meta quiet-link back-link" href="/projects">
        <Icon name="arrow-left" />
        {site.labels.backToProjects}
      </a>
      <span class="meta">
        {[formatYears(start, end), company]
          .filter(Boolean)
          .join(site.labels.metaSeparator)}
      </span>
      <PlatformLinks project={project} labelled />
    </div>
    <p class="description muted">{description}</p>
    {cover && (
      <Image
        class="cover"
        src={cover.src}
        alt={cover.alt}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 52rem) 60vw, 100vw"
        loading="eager"
      />
    )}
    <div class="content">
      <Prose>
        <Content components={{ Chip }} />
      </Prose>
    </div>
  </Section>
</Base>

<style>
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-m);
  }

  .description {
    max-width: var(--layout-measure);
  }

  .cover {
    display: block;
    width: 100%;
    max-width: var(--layout-wide);
    height: auto;
    margin-block-start: var(--space-prose);
    border-radius: var(--radius-m);
  }

  .content {
    margin-block-start: var(--space-prose);
  }

  @media (min-width: 52rem) {
    .project-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
