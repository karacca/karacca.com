---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import Chip from "@/components/Chip.astro";
import Gallery from "@/components/Gallery.astro";
import Highlights from "@/components/Highlights.astro";
import Icon from "@/components/Icon.astro";
import PlatformLinks from "@/components/PlatformLinks.astro";
import Prose from "@/components/Prose.astro";
import Screens from "@/components/Screens.astro";
import Screenshot from "@/components/Screenshot.astro";
import Section from "@/components/Section.astro";
import ThemedImage from "@/components/ThemedImage.astro";
import Base from "@/layouts/Base.astro";
import { getProjects } from "@/lib/content";
import { site } from "@/site.config";
import { image } from "@/styles/tokens/image";

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props;
const {
  title,
  description,
  year,
  company,
  role,
  highlights,
  icon,
  gallery,
  screens,
} = project.data;
const { Content } = await render(project);
---

<Base title={title} description={description}>
  <Section as="article" title={title}>
    {icon && (
      <Fragment slot="lead">
        <ThemedImage
          class="app-icon"
          src={icon.src}
          dark={icon.dark}
          alt=""
          widths={[...image.icon.widths]}
          sizes={image.icon.sizes}
          loading="eager"
        />
      </Fragment>
    )}
    <div class="project-meta" slot="rail">
      <a class="meta quiet-link back-link" href="/projects">
        <Icon name="arrow-left" />
        {site.labels.backToProjects}
      </a>
      <span class="meta">
        {[year, company].filter(Boolean).join(site.labels.metaSeparator)}
        {role && (
          <span class="role">
            <span class="role-separator">{site.labels.metaSeparator}</span>
            {role}
          </span>
        )}
      </span>
      <PlatformLinks project={project} labelled />
    </div>
    <p class="description muted" slot="intro">
      {description}
    </p>
    {highlights.length > 0 && <Highlights class="summary" items={highlights} />}
    {gallery.length > 0 && (
      <Gallery class="media" slides={gallery} title={title} />
    )}
    {screens.length > 0 && (
      <Screens
        class="media"
        screens={screens}
        title={title}
        eager={gallery.length === 0}
      />
    )}
    <div class="content">
      <Prose>
        <Content components={{ Chip, Screens, Screenshot }} />
      </Prose>
    </div>
  </Section>
</Base>

<style>
  .project-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .app-icon {
    display: block;
    width: var(--layout-icon);
    height: auto;
    border-radius: var(--radius-icon);
  }

  .description {
    max-width: var(--layout-measure);
  }

  .summary,
  .media {
    margin-block-start: var(--space-prose);
  }

  .media {
    max-width: var(--layout-wide);
  }

  .content {
    margin-block-start: var(--space-prose);
  }

  @media (width < 52rem) {
    .project-meta {
      margin-block-end: var(--space-m);
    }
  }

  @media (min-width: 52rem) {
    .role {
      display: block;
    }

    .role-separator {
      display: none;
    }
  }
</style>
