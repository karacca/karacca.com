---
import { render } from "astro:content";
import BookCall from "@/components/BookCall.astro";
import Chip from "@/components/Chip.astro";
import Prose from "@/components/Prose.astro";
import ResumeLink from "@/components/ResumeLink.astro";
import Section from "@/components/Section.astro";
import Signature from "@/components/Signature.astro";
import Base from "@/layouts/Base.astro";
import { getPage } from "@/lib/content";

const page = await getPage("about");
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
  <Section as="div" title={page.data.title} hideTitle>
    <Prose>
      <Content components={{ BookCall, Chip, ResumeLink }} />
    </Prose>
    <div class="sign-off">
      <Signature />
    </div>
  </Section>
</Base>

<style>
  .sign-off {
    display: flex;
    justify-content: flex-end;
    max-width: var(--layout-measure);
    margin-block-start: var(--space-xl);
  }
</style>
