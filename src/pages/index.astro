---
import { render } from "astro:content";
import Actions from "@/components/Actions.astro";
import Chip from "@/components/Chip.astro";
import PostList from "@/components/PostList.astro";
import ProjectList from "@/components/ProjectList.astro";
import Prose from "@/components/Prose.astro";
import Section from "@/components/Section.astro";
import Base from "@/layouts/Base.astro";
import { getPage, getPosts, getProjectsByImpact, label } from "@/lib/content";

const page = await getPage("home");
const { Content } = await render(page);
const posts = (await getPosts()).slice(0, 5);
const projects = (await getProjectsByImpact()).slice(0, 3);
---

<Base title={page.data.title} description={page.data.description} isHome>
  <Section as="header" title={page.data.heading ?? page.data.title}>
    <Prose>
      <Content components={{ Chip }} />
    </Prose>
    <Actions />
  </Section>
  {posts.length > 0 && (
    <Section label={label(page, "writing")}>
      <PostList posts={posts} />
      <p class="more">
        <a class="action-link" href="/writing">
          {label(page, "allWriting")}
        </a>
      </p>
    </Section>
  )}
  {projects.length > 0 && (
    <Section label={label(page, "projects")}>
      <ProjectList projects={projects} />
      <p class="more">
        <a class="action-link" href="/projects">
          {label(page, "allProjects")}
        </a>
      </p>
    </Section>
  )}
</Base>

<style>
  .more {
    margin-block-start: var(--space-s);
    font-size: var(--text-size-small);
  }
</style>
