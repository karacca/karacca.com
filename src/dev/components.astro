---
import Actions from "@/components/Actions.astro";
import Chip from "@/components/Chip.astro";
import ContributionsChart from "@/components/ContributionsChart.astro";
import Gallery from "@/components/Gallery.astro";
import Highlights from "@/components/Highlights.astro";
import PlatformLinks from "@/components/PlatformLinks.astro";
import PostList from "@/components/PostList.astro";
import ProjectList from "@/components/ProjectList.astro";
import Prose from "@/components/Prose.astro";
import Screens from "@/components/Screens.astro";
import Screenshot from "@/components/Screenshot.astro";
import Section from "@/components/Section.astro";
import Signature from "@/components/Signature.astro";
import Content, { frontmatter } from "@/content/dev/components.mdx";
import Base from "@/layouts/Base.astro";
import { getPosts, getProjects } from "@/lib/content";

const projects = await getProjects();
const posts = await getPosts();
const live = projects.find(({ id }) => id === frontmatter.platforms);
const offline = live && { ...live, data: { ...live.data, links: {} } };
const highlights =
  projects.find(({ id }) => id === frontmatter.highlights)?.data.highlights ??
  [];
---

<Base
  title={frontmatter.title}
  description={frontmatter.description}
  ogImage={false}
  noindex
>
  <Content
    components={{
      Actions,
      Chip,
      ContributionsChart,
      Gallery,
      Highlights,
      PlatformLinks,
      PostList,
      ProjectList,
      Prose,
      Screens,
      Screenshot,
      Section,
      Signature,
    }}
    projects={projects}
    posts={posts}
    live={live}
    offline={offline}
    highlights={highlights}
  />
</Base>

<style>
  :global(.section > .body > * + *) {
    margin-block-start: var(--space-prose);
  }
</style>
